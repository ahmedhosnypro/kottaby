# ==========================================
# CI test-environment template (COMMITTED) — .env.test.ci
# ==========================================
# no secrets; CI fixture values only; values marked `overridden-by-ci` are
# replaced by workflow env.
#
# Consumed by scripts/ci/materialize-env-test.ts (Task 2.2) to produce the
# GITIGNORED runtime file `.env.test` used by `bun --env-file=.env.test`
# test entry points (test:db, test:services, build:test, ...).
# NEVER put real credentials in this file — real values arrive via GitHub
# Actions step-level env mapping (REQ-031), never echoed (REQ-038).

# Test posture flags (REQ-022): compact domain-error logs + CI mode markers.
TEST_SERVER=1
TEST_CI=1

# Replaced at materialization time by the workflow-provided ephemeral
# Postgres service-container URL (REQ-031). The placeholder below must be
# overridden or materialization fails fast with a named missing variable.
DATABASE_URL=overridden-by-ci

# FIXED CI-ONLY FIXTURE — 64-hex-char AES-256 key SHAPE, deterministic and
# obviously non-production (patterned literal, never rotated, protects
# nothing). Satisfies backend/lib/env.ts "required in production" shape check
# and backend/lib/auth/jwt.ts dev-fallback hashing without any secret value.
DATABASE_ENCRYPTION_KEY=cafef00dcafe1234cafef00dcafe1234cafef00dcafe1234cafef00dcafe1234

# http://localhost-friendly auth cookies for test servers over plain HTTP
# (backend/lib/auth/cookies.ts Secure-flag override; see test/ui/AGENTS.md).
AUTH_COOKIE_SECURE=false
