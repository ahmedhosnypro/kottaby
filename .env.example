# ==========================================
# Environment Configuration Template
# ==========================================

# ------------------------------------------
# Database Configuration
# ------------------------------------------
# Database provider: 'postgres' or 'neon'
DB_PROVIDER=postgres

# Database connection mode: 'auto' (default, respects DB_PROVIDER), 'pg' (pg-pooled), 'neon' (neon-serverless)
# DB_CONNECTION_MODE=auto

# Database connection (local-dev default — PostgreSQL on 127.0.0.1).
# Production / Neon: replace with `postgresql://<user>:<password>@<host>:5432/kottaby`.
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/kottaby

# Database Encryption Key used for Column-Level Encryption (AES-256-GCM)
# IMPORTANT: Generate a strong random key. Never use default values in production!
# Generate with: openssl rand -base64 32
DATABASE_ENCRYPTION_KEY=<your-database-encryption-key-here>

# Seed profile: minimal (fast CI smoke) or standard (full business dataset)
SEED_PROFILE=standard
# Optional fixed anchor date for reproducible calendar data (ISO 8601)
SEED_ANCHOR_DATE=2026-06-25

# For Neon (uncomment and use when DB_PROVIDER=neon)
# DATABASE_URL=postgresql://<user>:<password>@ep-example-123456.us-east-1.aws.neon.tech/neondb?sslmode=require

# For Neon integration tests (uncomment and use for Neon integration tests only)
# NEON_TEST_DATABASE_URL=postgresql://<user>:<password>@ep-example-123456.us-east-1.aws.neon.tech/neondb?sslmode=verify-full

# ------------------------------------------
# JWT Configuration
# ------------------------------------------
# JWT secrets for access + refresh tokens (HS256).
# In development, these default to DATABASE_ENCRYPTION_KEY if not set
# (see `backend/lib/auth/jwt.ts` → `deriveDevSecret`).
# In production, set distinct secrets for each token type:
# JWT_ACCESS_SECRET=<your-access-token-secret-here>
# JWT_REFRESH_SECRET=<your-refresh-token-secret-here>

# ------------------------------------------
# Redis Configuration
# ------------------------------------------
# Redis provider: 'local' or 'upstash'
REDIS_PROVIDER=local

# Local Redis (when REDIS_PROVIDER=local)
REDIS_URL=redis://localhost:6379

# Upstash Redis (when REDIS_PROVIDER=upstash)
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token-here

# Upstash Redis integration tests (uncomment and use for Upstash integration tests only)
# UPSTASH_TEST_REDIS_REST_URL=https://your-test-redis.upstash.io
# UPSTASH_TEST_REDIS_REST_TOKEN=your-test-token-here

# Redis Cloud integration tests (uncomment and use for Redis Cloud integration tests only)
# REDIS_CLOUD_TEST_REDIS_URL=redis://default:password@redis-12345.c1.us-east-1-2.ec2.redns.redis-cloud.com:12345


# ------------------------------------------
# Lint Queue Server
# ------------------------------------------
# Port for the lint queue server (see scripts/lint-queue-config.ts)
LINT_QUEUE_PORT=4777

# ------------------------------------------
# Environment
# ------------------------------------------
# Do NOT set NODE_ENV here. Bun loads .env into the process before `next build`,
# and a non-production value breaks static prerender (viewport/meta key errors,
# TypeError reading 'length'). Next.js / the build scripts set NODE_ENV themselves.
# NODE_ENV=development

# ------------------------------------------
# CORS Configuration
# ------------------------------------------
# Production deployments MUST set this to the HTTPS origin (e.g. https://kottaby.example.com).
# Leaving it as http://localhost:3000 in production disables Secure on auth cookies
# (the server warns but still marks them Secure in production per backend/lib/auth/cookies.ts).
ALLOWED_ORIGIN=http://localhost:3000

# ------------------------------------------
# Storage Configuration
# ------------------------------------------
# Storage provider: 'local' or 'gcp'
STORAGE_PROVIDER=local

# Local Storage Configuration (when STORAGE_PROVIDER=local)
LOCAL_STORAGE_PATH=./storage/

# Public base URL of the application (no trailing slash)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Signed URL Cleanup Configuration (when STORAGE_PROVIDER=local)
SIGNED_URL_CLEANUP_STRATEGY=lazy
SIGNED_URL_CLEANUP_CRON_SCHEDULE=0 * * * *
# IMPORTANT: Generate a strong random secret. Never use default values in production!
# Generate with: openssl rand -base64 32
# Consumed by /api/storage/cleanup (signed URL cleanup) AND /api/fx/refresh (FX cron).
CRON_SECRET=<your-cron-secret-here>

# ==========================================
# Cron Execution Configuration
# ==========================================
# Cron execution mode (drives build-time vercel.json generation):
#   vercel        - Vercel native cron (Pro required for sub-daily)
#   vercel-daily  - Vercel native cron, daily only (Hobby safe, DEFAULT)
#   external      - External scheduler calls /api/cron/ticker (free sub-daily on Hobby)
#   standalone    - Separate worker process (bun scripts/cron-worker.ts)
CRON_EXECUTION_MODE=vercel-daily

# Individual cron schedules (cron expressions, UTC)
# Validated at build time with cron-parser
CRON_FX_REFRESH_SCHEDULE=0 6 * * *
CRON_CLASS_REMINDERS_SCHEDULE=0 6 * * *
CRON_TICKER_SCHEDULE=* * * * *

# External cron scheduler integration (cron-job.org, QStash, GitHub Actions, etc.)
# When CRON_EXTERNAL_ENABLED=true, documents the endpoint for external services
CRON_EXTERNAL_ENABLED=false
CRON_EXTERNAL_ENDPOINT=/api/cron/ticker
CRON_EXTERNAL_SCHEDULE=* * * * *
# CRON_EXTERNAL_SECRET defaults to CRON_SECRET if not set
# CRON_EXTERNAL_SECRET=your-external-cron-secret

# ------------------------------------------
# FX Rate Ingestion
# ------------------------------------------
# Provider: 'openexchangerates' (USD base) or 'fixer' (EUR base, normalised to USD hub)
FX_PROVIDER=openexchangerates

# OpenExchangeRates App ID (get from https://openexchangerates.org/dashboard/app-ids)
OPENEXCHANGERATES_APP_ID=<your-openexchangerates-app-id>

# Fixer API Key (get from https://apilayer.com/marketplace/fixer-api)
FIXER_API_KEY=<your-fixer-api-key>

# Google Cloud Platform Storage (when STORAGE_PROVIDER=gcp)
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_SECRET_VERSION=latest
# GCP_SECRET_ID=your-secret-id
# GCP_BUCKET_NAME=your-bucket-name

# SECURITY: These values MUST be changed before deploying. Never use defaults in production.
# System Super Admin Account
# This account is created during database seeding and is required for system operations.
# The email is used by seeders and system processes. Must be unique.
ADMIN_EMAIL=<your-admin-email>
# Set a secure password for the admin account
ADMIN_PASSWORD=<your-admin-password-here>

# ------------------------------------------
# Cache Configuration
# ------------------------------------------
# Cache provider: 'redis' or 'postgres'
CACHE_PROVIDER=postgres

# GraphQL Binary Serialization
# IMPORTANT: Generate a strong random key. Never use default values in production!
# Generate with: openssl rand -base64 32
GRAPHQL_ENCRYPTION_KEY=<your-graphql-encryption-key-here>
NEXT_PUBLIC_ENABLE_BINARY_GRAPHQL=true

# Users directory (consolidated /users tabbed parent).
# Runtime value can also be overridden in Settings → Environment (DB wins over env).
# NEXT_PUBLIC_ENABLE_USERS_DIRECTORY=false

# Google Fonts API Key (Optional)
GOOGLE_FONTS_API_KEY=

# Vercel Blob Storage Token (Optional)
BLOB_READ_WRITE_TOKEN=

# Demo Site Configuration
# NEXT_PUBLIC_IS_DEMO: controls client-side demo UI visibility.
# IS_DEMO: server-side gate for demoLogin mutation (security-critical).
NEXT_PUBLIC_IS_DEMO=false
IS_DEMO=false

# Auth cookie Secure flag override.
# Omit in real HTTPS production (cookies default to Secure when NODE_ENV=production).
# Set to "false" only for local production-mode servers over HTTP (e.g. `next start`
# on http://localhost during UI/E2E tests). Required in .env.test for Playwright.
# AUTH_COOKIE_SECURE=false

# ------------------------------------------
# Reverse Proxy / Rate Limiting
# ------------------------------------------
# Set to "true" ONLY when the app is deployed behind a real reverse proxy
# (nginx / haproxy / CDN ingress on a self-hosted VPS) that overwrites
# x-forwarded-for / x-real-ip. When set, those headers are used as the client
# identifier for rate limiting (GraphQL context + /api/graphql + webhooks).
# Leave UNSET on direct deployments — otherwise any client can spoof its IP
# and rotate out of rate-limit buckets (MITM/brute-force protection bypass).
# Not needed on Vercel (x-vercel-forwarded-for) or Cloudflare (cf-connecting-ip) —
# those platform headers are trusted automatically.
# TRUSTED_PROXY=true

# ------------------------------------------
# Logging Configuration
# ------------------------------------------
# Server-side logger + client-log ingestion route (app/api/logs/route.ts).
# When "true", server logger writes to logs/server.log AND the /api/logs
# route accepts client batch POSTs, writing them to logs/client_<sessionId>.log.
# Defaults off in production (on in development) — set to "true" on prod to
# triage browser-side diagnostics (e.g. [AuthRedirect] recovery path).
# ENABLE_LOGGING=true
#
# NEXT_PUBLIC_ mirror: the client logger reads NEXT_PUBLIC_ENABLE_LOGGING
# (frontend/lib/logger/index.ts) to enable prod console output.
# Set BOTH on prod when you want client-side diagnostics to flow to BOTH
# the browser console AND logs/client_<sessionId>.log on the server.
# NEXT_PUBLIC_ENABLE_LOGGING=true

# ------------------------------------------
# Test / Dev Server Flags
# ------------------------------------------
# Set TEST_SERVER=1 only when running the GraphQL/UI test harness that spawns
# `next start` for integration/E2E tests (see `backend/lib/logger.ts` — test
# mode tightens log levels). Real Vercel production MUST NEVER set this.
# TEST_SERVER=1

# ------------------------------------------
# Development Tools
# ------------------------------------------

# ------------------------------------------
# Communication Channels Configuration
# ------------------------------------------

# Email Configuration (Task D1)
# Email provider: 'resend' (default)
EMAIL_PROVIDER=resend

# Resend API Key (get from https://resend.com/api-keys)
# RESEND_API_KEY=re_your_api_key_here

# Sender email address (must be verified in Resend)
# RESEND_FROM_EMAIL=noreply@yourdomain.com

# SMS Configuration (Task D2)
# SMS provider: 'twilio' (default)
SMS_PROVIDER=twilio

# Twilio Account SID (get from https://console.twilio.com)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio Auth Token (get from https://console.twilio.com)
# TWILIO_AUTH_TOKEN=your_auth_token_here

# Twilio phone number (in E.164 format, e.g., +1234567890)
# TWILIO_FROM_NUMBER=+1234567890

# Push Notification Configuration (Task D3)
# Push provider: 'fcm' (default)
PUSH_PROVIDER=fcm

# Firebase Project ID (get from Firebase Console)
# FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Private Key (from Firebase Console > Project Settings > Service Accounts)
# IMPORTANT: Replace \n with actual newlines when pasting
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase Client Email (from Firebase Console > Project Settings > Service Accounts)
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# ------------------------------------------
# Test environment (.env.test)
# ------------------------------------------
# Gitignored (see `.env*` in .gitignore). Create locally from this section.
# All test scripts use `bun --env-file=.env.test` when the file exists
# (test:db, test:graphql, build:test, test:ui).
#
# TEST_CI: leave "false" locally. GitHub Actions sets TEST_CI=true on the CI job so
# test runners keep the workflow Postgres service URL instead of clearing DATABASE_URL
# before spawning bun test workers. CI does not require a `.env.test` file on disk.
# See backend/lib/test-ci-env.ts.
# TEST_CI=false
#
# TEST_SERVER: do not set manually. The GraphQL/UI test harness sets TEST_SERVER=1 when
# spawning `next start` for integration/E2E tests so test-helper mutations register
# under NODE_ENV=production. Real Vercel production must never set this (helpers are
# also blocked when VERCEL_ENV=production).
#
# Copy values below into `.env.test` for local overrides (API keys for live comm tests, etc.).
# Do not point DATABASE_URL at production or Neon in tests.
#
# Live-comm integration test recipients (optional — dependent tests skip when unset):
# RESEND_TEST_TO_EMAIL=your-resend-account-owner@gmail.com
# TWILIO_VERIFIED_TEST_RECIPIENT=+1xxxxxxxxxx
# FCM_TEST_DEVICE_TOKEN=your-fcm-registration-token

# -------------------- Meeting Integrations (auto-generation) --------------------
# Full setup guide: docs/services/meeting-provider-env-setup.md
#
# Zoom S2S OAuth (https://developers.zoom.us/docs/internal-apps/)
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_REQUIRED_SCOPES=meeting:write:meeting,user:read:user

# Google Meet (Service Account JSON + impersonation)
# GOOGLE_MEET_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_MEET_IMPERSONATE_SUBJECT=[EMAIL_REDACTED]
# Google Meet OAuth (client credentials)
# GOOGLE_MEET_CLIENT_ID=
# GOOGLE_MEET_CLIENT_SECRET=

# Microsoft Teams (client-credentials flow)
# MS_TEAMS_TENANT_ID=
# MS_TEAMS_CLIENT_ID=
# MS_TEAMS_CLIENT_SECRET=
# MS_TEAMS_ORGANIZER_USER_ID=
# MS_TEAMS_REQUIRED_SCOPES=https://graph.microsoft.com/OnlineMeetings.ReadWrite,User.Read

# OAuth redirect base URL (used for per-teacher OAuth callback)
# OAUTH_REDIRECT_BASE_URL=https://yourdomain.com

# ------------------------------------------
# WhatsApp Cloud API Configuration
# ------------------------------------------

# Production keys (required for live WhatsApp integration):
# WHATSAPP_PROVIDER=cloud_api
# WHATSAPP_APP_ID=your_meta_app_id
# WHATSAPP_API_VERSION=v23.0
# WHATSAPP_WEBHOOK_BASE_URL=https://your-domain.com/api/webhooks/whatsapp
# WHATSAPP_ACCESS_TOKEN=your_meta_graph_api_access_token
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# WHATSAPP_WABA_ID=your_whatsapp_business_account_id

# Webhook security (production-required for HMAC verification):
# WHATSAPP_APP_SECRET=your_app_secret_for_hmac_verification
# WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token

# Integration test keys (optional — integration tests skip when missing):
# WHATSAPP_TEST_TO_PHONE=recipient_number_digits_only
# WHATSAPP_TEST_TEMPLATE_NAME=hello_world
# WHATSAPP_TEST_TEMPLATE_LANGUAGE=en_US

# ------------------------------------------
# New Relic APM Agent (server-side)
# ------------------------------------------
# NEW_RELIC_LICENSE_KEY=<your-license-key>
# NEW_RELIC_APP_NAME=kottaby
# NEW_RELIC_OPENTELEMETRY_ENABLED=true
# NEW_RELIC_INSTRUMENTATION_NEXT_ENABLED=false
# NEW_RELIC_INSTRUMENTATION_HTTP_ENABLED=false
# NEW_RELIC_INSTRUMENTATION_UNDICI_ENABLED=false
# NEW_RELIC_LOG_ENABLED=true
# NEW_RELIC_LOG_LEVEL=info
# NEW_RELIC_LOG=stdout
# NEW_RELIC_NO_CONFIG_FILE=true
# NEW_RELIC_ENABLED=true

# ------------------------------------------
# New Relic Browser Agent (client-side)
# NEXT_PUBLIC_ prefix required — Next.js inlines these at build time for browser access.
# Values come from: New Relic → Browser → (your app) → Application settings.
# ------------------------------------------
# Browser JS ingest key (different from the APM license key):
# NEXT_PUBLIC_NEW_RELIC_BROWSER_LICENSE_KEY=NRJS-<your-browser-license-key>
# Your New Relic account ID:
# NEXT_PUBLIC_NEW_RELIC_ACCOUNT_ID=<account-id>
# Browser application / agent ID:
# NEXT_PUBLIC_NEW_RELIC_APPLICATION_ID=<application-id>
# Trust key (usually the same as account ID):
# NEXT_PUBLIC_NEW_RELIC_TRUST_KEY=<trust-key>
# Beacon hostname — eu01 for EU data centre, bam.nr-data.net for US:
# NEXT_PUBLIC_NEW_RELIC_BEACON=bam.eu01.nr-data.net

# ------------------------------------------
# Site Appearance — ENV Branding Override (Tier 3 fallback)
# ------------------------------------------
# Optional JSON payload that overrides the DEFAULT_APPEARANCE_FIELDS used
# during SSR when no published `appearance_settings` row exists yet
# (cold-start / pre-seed / CI prerender). Parsed + Zod-validated once per
# process by `readAppearanceFromEnv` in
# `backend/services/appearance/appearance-settings.service.ts`.
#
# Resolution ladder (first non-null wins):
#   1. In-memory TTL memo (15s)
#   2. `unstable_cache` DB read (published row)
#   3. THIS env var (NEXT_PUBLIC_APP_BRANDING)
#   4. DEFAULT_APPEARANCE_FIELDS (canonical theme snapshot)
#
# On invalid JSON or schema failure, the helper logs a domain warning once
# per process and falls back to DEFAULT_APPEARANCE_FIELDS (AC-27, AC-38).
# Format: a JSON object matching `AppearanceFields`
# (see shared/schemas/appearance.schema.json for the canonical schema).
# All 4 color fields MUST be 6-digit hex (#RRGGBB); logoUrl may be null or
# a parseable URL; defaultColorScheme is "light" or "dark".
#
# Example (single-line; the parser tolerates pretty-printed JSON too):
# NEXT_PUBLIC_APP_BRANDING={"colors":{"light":{"primaryMain":"#0D9488","secondaryMain":"#4F46E5"},"dark":{"primaryMain":"#2DD4BF","secondaryMain":"#818CF8"}},"logoUrl":null,"siteName":"Kottaby","siteTitle":"Kottaby","siteDescription":"Kottaby education management","defaultColorScheme":"dark"}
