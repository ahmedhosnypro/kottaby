{
  "threshold": 100,
  "minTokens": 75,
  "minLines": 8,
  "format": ["typescript", "tsx"],
  "path": ["."],
  "ignore": [
    "**/ai/**",
    "**/.agents/**",
    "**/.cursor/**",
    "**/.git/**",
    "**/.github/**",
    "**/.husky/**",
    "**/.kiro/**",
    "**/.next/**",
    "**/.next-dev/**",
    "**/.next-test*/**",
    "**/.playwright-mcp/**",
    "**/.scannerwork/**",
    "**/.stakpak/**",
    "**/.vercel/**",
    "**/.vscode/**",
    "node_modules/**",
    "out/**",
    "build/**",
    "dist/**",
    "logs/**",
    "storage/**",
    "scratch/**",
    "Kottaby/**",
    "storybook-static/**",
    "docs/**",
    "coverage/**",
    "**/*.d.ts",
    "next-env.d.ts",
    "**/messages/**",
    "frontend/graphql/generated/**",
    "**/unRefactored_tests/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/seeds/**",
    "**/migration/**",
    "**/*.stories.tsx"
  ]
}
